#OddOccurancesInArray
A = list(map(int, input("Enter the array elements seperated by spaces: ").split()))
#now writing the function
def solution(A):
# Create an empty set called odd_count[cite: 3]
    odd_count = set()
# Use a for loop that goes through each element in A:
    for element in A:
      # Use an if statement when (element is already in odd_count):
        if element in odd_count:
            # Then remove element from odd_count[cite: 3]
            odd_count.remove(element)
        else:
            # Then add element to odd_count
            odd_count.add(element)
            
    # Return one element left in odd_count
    for x in odd_count:
        return x

#Frog Jump
# Take an integer user input for X:
X = int(input("Enter X: "))

# Take an integer user input for Y:
Y = int(input("Enter Y: "))

# Take an integer user input for D:
D = int(input("Enter D: "))

# Use the function solution (pass int X, pass int Y, pass int D)
def solution(X, Y, D):
    # Initialize distance as Y - X
    distance = Y - X
    
    # Initialize jumps as distance // D
    jumps = distance // D
    
    # Use an if statement (distance % D != 0):
    if distance % D != 0:
        # Then jump increments by 1
        jumps += 1
        
    # Return jumps[cite: 4]
    return jumps
